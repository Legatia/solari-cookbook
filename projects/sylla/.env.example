# Runtime
APP_BASE_URL=http://localhost:3000
INTEGRATION_MODE=mock
# Prototype convenience only. Disable this and require /join/<token> for a real event.
SYLLA_ENABLE_DEMO_SESSIONS=true

# Server-only credentials
AUTH_SECRET=
DATABASE_URL=
SOLARI_API_KEY=
MODEL_API_KEY=
SYLLA_INTERNAL_MODEL_MODE=mock
# Required only when SYLLA_INTERNAL_MODEL_MODE=live. No model is assumed.
SYLLA_INTERNAL_MODEL=
SYLLA_TRIAL_CREDITS=500

# Vercel sends this bearer secret to the automatic fallback sweep.
CRON_SECRET=
SYLLA_FALLBACK_SWEEP_LIMIT=10

# Optional external OAuth resource-server configuration. Without these values,
# Sylla serves its built-in OAuth 2.1 + PKCE flow at APP_BASE_URL.
# An external provider issues JWTs with audience APP_BASE_URL/mcp and scope sylla:agent.
SYLLA_OAUTH_ISSUER=
SYLLA_OAUTH_JWKS_URL=
SYLLA_OAUTH_AUDIENCE=

# Temporary developer MCP bridge. Keep disabled in public deployments; the
# built-in OAuth flow is the production-facing default.
SYLLA_ENABLE_DEV_MCP=false
SYLLA_MCP_DEV_TOKEN=
SYLLA_MCP_DEV_PARTICIPANT_ID=

# Solari defaults
SOLARI_BASE_URL=https://api.getsolari.com
